# Names only — never real values. Real keys live in ~/.config/, outside the repo.
HF_TOKEN=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional. Where the local LLM fallback runs; defaults to http://localhost:11434.
# No key — the weights are on this machine and nobody is billed.
VOX_OLLAMA_HOST=

# Optional. Seconds a hosted arm gets before the turn falls back to local. Defaults to 10.
VOX_REMOTE_TIMEOUT_S=
